# ─────────────────────────────────────────────────────────────
# Brevio — environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.
# VITE_* are exposed to the browser (safe / public keys only).
# All others are server-side (Vercel Functions) — keep secret.
# ─────────────────────────────────────────────────────────────

# Supabase — public (browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — server only (admin, bypasses RLS — NEVER expose)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude) — server only
ANTHROPIC_API_KEY=

# Stripe — server only (Test mode keys while developing)
# sk_test_… — from Developers → API keys
STRIPE_SECRET_KEY=
# price_… — the recurring price of the Pro plan, NOT the product id (prod_…)
STRIPE_PRICE_ID_PRO=
# whsec_… — Step 9 only, printed by `stripe listen` or the dashboard endpoint
STRIPE_WEBHOOK_SECRET=

# Stripe — public (browser). Not read yet: Checkout is opened server-side and
# the browser only follows the returned URL. Needed if Elements is added later.
VITE_STRIPE_PUBLISHABLE_KEY=

# Base URL used for Stripe redirects. Never derived from the request host —
# that is caller-controlled and would make success_url an open redirect.
# Defaults to http://localhost:5173 locally and to VERCEL_URL when deployed.
APP_URL=
