# ─────────────────────────────────────────────────────────────
# Brevio — environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.
# VITE_* are exposed to the browser (safe / public keys only).
# All others are server-side (Vercel Functions) — keep secret.
# ─────────────────────────────────────────────────────────────

# Supabase — public (browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — server only (admin, bypasses RLS — NEVER expose)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude) — server only
ANTHROPIC_API_KEY=

# Stripe — server only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Stripe — public (browser)
VITE_STRIPE_PUBLISHABLE_KEY=
